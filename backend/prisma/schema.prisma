// StockPulse Production Multi-Tenant SaaS Schema
// PostgreSQL Source of Truth with strict tenant scoping and integer minor currency units

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  OWNER
  ADMINISTRATOR
  MANAGER
  SALES_STAFF
  WAREHOUSE_STAFF
  PRODUCTION_STAFF
  ACCOUNTANT
  VIEWER
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALES_DISPATCH
  PRODUCTION_ISSUE
  PRODUCTION_RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL
}

enum OrderStatus {
  DRAFT
  QUOTED
  CONFIRMED
  AWAITING_STOCK
  IN_PRODUCTION
  READY_FOR_DISPATCH
  PARTIALLY_DISPATCHED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ProductionBatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DispatchStatus {
  PLANNED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Tenant {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  slug                String   @unique
  currencyCode        String   @default("INR")
  countryCode         String   @default("IN")
  taxRegistrationNo   String?  // e.g. GSTIN
  financialYearStart  Int      @default(4) // April (1-12)
  allowNegativeStock  Boolean  @default(false)
  valuationMethod     String   @default("WEIGHTED_AVERAGE")
  planTier            String   @default("GROWTH")
  isDemo              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  branches            Branch[]
  memberships         TenantMembership[]
  roles               Role[]
  categories          ProductCategory[]
  products            Product[]
  warehouses          Warehouse[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  stockReservations   StockReservation[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]
  customers           Customer[]
  quotations          Quotation[]
  orders              Order[]
  boms                BillOfMaterials[]
  productionBatches   ProductionBatch[]
  dispatches          Dispatch[]
  invoices            Invoice[]
  payments            Payment[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  outboxEvents        OutboxEvent[]
  idempotencyRecords  IdempotencyRecord[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  fullName     String
  passwordHash String
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     TenantMembership[]
  refreshSessions RefreshSession[]

  @@map("users")
}

model TenantMembership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tenantId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@map("refresh_sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        RoleName
  description String?
  createdAt   DateTime @default(now())

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships     TenantMembership[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  categoryId         String?  @db.Uuid
  sku                String
  barcode            String?
  name               String
  description        String?
  uom                String   @default("PCS") // KG, BAG, TON, MTR, PCS
  productType        String   @default("FINISHED_GOOD") // RAW_MATERIAL | FINISHED_GOOD | CONSUMABLE
  purchasePriceMinor BigInt   @default(0) // Integer minor units (paise/cents)
  sellingPriceMinor  BigInt   @default(0) // Integer minor units (paise/cents)
  taxRateBps         Int      @default(1800) // Basis points: 1800 = 18.00% GST
  reorderThreshold   Decimal  @default(0) @db.Decimal(14, 3)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      ProductCategory?  @relation(fields: [categoryId], references: [id])
  stockBalances StockBalance[]
  movements     StockMovement[]
  reservations  StockReservation[]

  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@index([tenantId, categoryId])
  @@map("products")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String?  @db.Uuid
  code      String
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?           @relation(fields: [branchId], references: [id])
  stockBalances StockBalance[]
  movements     StockMovement[]
  reservations  StockReservation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model StockBalance {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  warehouseId    String   @db.Uuid
  productId      String   @db.Uuid
  onHandQty      Decimal  @default(0) @db.Decimal(14, 3)
  reservedQty    Decimal  @default(0) @db.Decimal(14, 3)
  unitCostMinor  BigInt   @default(0)
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId, productId])
  @@map("stock_balances")
}

model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  warehouseId       String            @db.Uuid
  productId         String            @db.Uuid
  movementType      StockMovementType
  quantityDelta     Decimal           @db.Decimal(14, 3) // + for inflow, - for outflow
  balanceAfter      Decimal           @db.Decimal(14, 3)
  unitCostMinor     BigInt            @default(0)
  referenceType     String            // OPENING | PO_GRN | ORDER | PRODUCTION | TRANSFER | ADJUSTMENT | REVERSAL
  referenceId       String?
  reason            String
  reversedMovementId String?          @db.Uuid
  actorUserId       String            @db.Uuid
  createdAt         DateTime          @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, warehouseId, productId, createdAt])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

model StockReservation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  warehouseId String   @db.Uuid
  productId   String   @db.Uuid
  orderId     String   @db.Uuid
  reservedQty Decimal  @db.Decimal(14, 3)
  fulfilledQty Decimal @default(0) @db.Decimal(14, 3)
  status      String   @default("ACTIVE") // ACTIVE | FULFILLED | RELEASED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([tenantId, warehouseId, productId])
  @@map("stock_reservations")
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  code          String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  taxId         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  supplierId  String   @db.Uuid
  warehouseId String   @db.Uuid
  poNumber    String
  status      String   @default("ISSUED") // DRAFT | ISSUED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  totalMinor  BigInt   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String @db.Uuid
  productId      String  @db.Uuid
  orderedQty     Decimal @db.Decimal(14, 3)
  receivedQty    Decimal @default(0) @db.Decimal(14, 3)
  rejectedQty    Decimal @default(0) @db.Decimal(14, 3)
  unitCostMinor  BigInt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  purchaseOrderId String   @db.Uuid
  warehouseId     String   @db.Uuid
  grnNumber       String
  idempotencyKey  String
  receivedByUserId String  @db.Uuid
  notes           String?
  createdAt       DateTime @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]

  @@unique([tenantId, grnNumber])
  @@unique([tenantId, idempotencyKey])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String  @id @default(uuid()) @db.Uuid
  goodsReceiptId String  @db.Uuid
  productId      String  @db.Uuid
  receivedQty    Decimal @db.Decimal(14, 3)
  rejectedQty    Decimal @default(0) @db.Decimal(14, 3)
  unitCostMinor  BigInt

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}

model Customer {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  code               String
  name               String
  phone              String?
  email              String?
  taxId              String?  // GSTIN / VAT
  billingAddress     String?
  shippingAddress    String?
  creditLimitMinor   BigInt   @default(0)
  paymentTermsDays   Int      @default(30)
  createdAt          DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotations Quotation[]
  orders     Order[]
  invoices   Invoice[]
  payments   Payment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("customers")
}

model Quotation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  customerId      String   @db.Uuid
  quoteNumber     String
  status          String   @default("DRAFT") // DRAFT | SENT | ACCEPTED | CONVERTED | EXPIRED
  subtotalMinor   BigInt
  discountMinor   BigInt   @default(0)
  taxMinor        BigInt
  totalMinor      BigInt
  validUntil      DateTime?
  createdAt       DateTime @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id])
  items    QuotationItem[]

  @@unique([tenantId, quoteNumber])
  @@map("quotations")
}

model QuotationItem {
  id            String  @id @default(uuid()) @db.Uuid
  quotationId   String  @db.Uuid
  productId     String  @db.Uuid
  quantity      Decimal @db.Decimal(14, 3)
  unitPriceMinor BigInt
  discountMinor BigInt  @default(0)
  taxRateBps    Int

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  customerId      String      @db.Uuid
  warehouseId     String      @db.Uuid
  orderNumber     String
  quotationId     String?     @db.Uuid
  status          OrderStatus @default(DRAFT)
  subtotalMinor   BigInt
  discountMinor   BigInt      @default(0)
  taxMinor        BigInt
  totalMinor      BigInt
  notes           String?
  createdByUserId String      @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  reservations StockReservation[]
  dispatches   Dispatch[]
  invoices     Invoice[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @db.Uuid
  productId      String  @db.Uuid
  orderedQty     Decimal @db.Decimal(14, 3)
  dispatchedQty  Decimal @default(0) @db.Decimal(14, 3)
  unitPriceMinor BigInt
  discountMinor  BigInt  @default(0)
  taxRateBps     Int
  lineTotalMinor BigInt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model BillOfMaterials {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  finishedProductId    String   @db.Uuid
  code                 String
  name                 String
  baseOutputQty        Decimal  @default(1) @db.Decimal(14, 3)
  estLaborCostMinor    BigInt   @default(0)
  estOverheadCostMinor BigInt   @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items   BomItem[]
  batches ProductionBatch[]

  @@unique([tenantId, code])
  @@index([tenantId, finishedProductId])
  @@map("bills_of_materials")
}

model BomItem {
  id             String  @id @default(uuid()) @db.Uuid
  bomId          String  @db.Uuid
  rawMaterialId  String  @db.Uuid
  quantityPerBase Decimal @db.Decimal(14, 3)
  scrapPercent   Decimal @default(0) @db.Decimal(5, 2)

  bom BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@map("bom_items")
}

model ProductionBatch {
  id                      String                @id @default(uuid()) @db.Uuid
  tenantId                String                @db.Uuid
  bomId                   String                @db.Uuid
  warehouseId             String                @db.Uuid
  finishedProductId       String                @db.Uuid
  batchNumber             String
  status                  ProductionBatchStatus @default(PLANNED)
  plannedQty              Decimal               @db.Decimal(14, 3)
  actualGoodQty           Decimal               @default(0) @db.Decimal(14, 3)
  rejectedWastageQty      Decimal               @default(0) @db.Decimal(14, 3)
  estimatedCostMinor      BigInt                @default(0)
  actualMaterialCostMinor BigInt                @default(0)
  actualLaborCostMinor    BigInt                @default(0)
  actualOverheadCostMinor BigInt                @default(0)
  actualTotalCostMinor    BigInt                @default(0)
  operatorUserId          String?               @db.Uuid
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime              @default(now())

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bom          BillOfMaterials       @relation(fields: [bomId], references: [id])
  consumptions MaterialConsumption[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId, status])
  @@map("production_batches")
}

model MaterialConsumption {
  id                String  @id @default(uuid()) @db.Uuid
  productionBatchId String  @db.Uuid
  rawMaterialId     String  @db.Uuid
  plannedQty        Decimal @db.Decimal(14, 3)
  actualConsumedQty Decimal @db.Decimal(14, 3)
  unitCostMinor     BigInt
  totalCostMinor    BigInt

  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

  @@map("material_consumptions")
}

model Dispatch {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  orderId        String         @db.Uuid
  warehouseId    String         @db.Uuid
  dispatchNumber String
  status         DispatchStatus @default(PLANNED)
  vehicleNumber  String?
  driverName     String?
  driverPhone    String?
  notes          String?
  podReference   String?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order          @relation(fields: [orderId], references: [id])
  items  DispatchItem[]

  @@unique([tenantId, dispatchNumber])
  @@index([tenantId, status])
  @@map("dispatches")
}

model DispatchItem {
  id         String  @id @default(uuid()) @db.Uuid
  dispatchId String  @db.Uuid
  productId  String  @db.Uuid
  quantity   Decimal @db.Decimal(14, 3)

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@map("dispatch_items")
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  customerId       String        @db.Uuid
  orderId          String?       @db.Uuid
  financialYear    String        // e.g. "2026-27"
  invoiceNumber    String        // e.g. "INV-2026-27-0001"
  status           InvoiceStatus @default(ISSUED)
  currencyCode     String        @default("INR")
  subtotalMinor    BigInt
  discountMinor    BigInt        @default(0)
  taxMinor         BigInt
  totalMinor       BigInt
  paidMinor        BigInt        @default(0)
  balanceDueMinor  BigInt
  issuedAt         DateTime      @default(now())
  dueDate          DateTime
  createdAt        DateTime      @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id])
  order    Order?        @relation(fields: [orderId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, financialYear, invoiceNumber])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, customerId])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @db.Uuid
  productId      String  @db.Uuid
  description    String
  quantity       Decimal @db.Decimal(14, 3)
  unitPriceMinor BigInt
  discountMinor  BigInt  @default(0)
  taxRateBps     Int
  taxMinor       BigInt
  lineTotalMinor BigInt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  invoiceId         String   @db.Uuid
  customerId        String   @db.Uuid
  paymentNumber     String
  amountMinor       BigInt   // Positive for receipt, negative for reversal
  method            String   // BANK_TRANSFER | UPI | CHEQUE | CASH
  reference         String
  isReversal        Boolean  @default(false)
  reversedPaymentId String?  @db.Uuid
  idempotencyKey    String
  recordedByUserId  String   @db.Uuid
  paidAt            DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([tenantId, paymentNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, invoiceId])
  @@map("payments")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  userId     String?   @db.Uuid
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  dedupeKey  String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isRead, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  actorId    String   @db.Uuid
  actorRole  String
  action     String
  entityType String
  entityId   String
  metadata   Json
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  eventType     String
  entityId      String
  schemaVersion String    @default("1.0")
  payload       Json
  status        String    @default("PENDING") // PENDING | PUBLISHED | FAILED
  attempts      Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  key          String
  operation    String
  responseCode Int
  responseBody Json
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, operation])
  @@map("idempotency_records")
}
