# Application Environment (development | test | production)
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# PostgreSQL (Primary Persistent Source of Truth)
DATABASE_URL="postgresql://stockpulse:stockpulse_dev_password@localhost:5432/stockpulse?schema=public"

# Redis (BullMQ Background Jobs & Socket.IO Adapter)
REDIS_URL="redis://localhost:6379"

# Security & Session Secrets (Replace in production via secret manager)
JWT_ACCESS_SECRET="replace-with-64-byte-cryptographic-random-secret-in-production"
JWT_REFRESH_SECRET="replace-with-64-byte-cryptographic-refresh-secret-in-production"
COOKIE_SECRET="replace-with-32-byte-cookie-signing-secret"
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# CORS & Security
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# S3-Compatible Object Storage (Documents, Invoices, PODs)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="stockpulse-documents"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Optional Transactional Email / WhatsApp Providers (Explicit Opt-In)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@stockpulse.local"
